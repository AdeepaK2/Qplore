                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Admin - Categories"
        ],
        "summary": "Delete a category (blocked if it has sub-categories or plants)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
